# 环境变量模板 —— 复制为 .env 后填入你自己的值
# ⚠️ 这个文件里绝不要出现真实 Key。真实 Key 只在你部署平台的「环境变量」里配置。

# 你的 API Key（在阿里云百炼控制台创建；本地调试时才会用到）
BAILIAN_API_KEY=

# 使用的模型（默认 qwen-plus，中文效果好、成本低）
BAILIAN_MODEL=qwen-plus

# 限流：每个 IP 每分钟最多请求次数（防公开接口被刷）
RATE_LIMIT=30

# 允许的前端来源。本地调试用 *；上线后请改成你的 GitHub Pages 域名，例如：
# ALLOW_ORIGIN=https://4hwwz9dy9d-ship-it.github.io
ALLOW_ORIGIN=*

# 本地服务器端口
PORT=8787
